{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "IdentityHub": "Information"
    }
  },
  "ConnectionStrings": {
    "AuthorizationDb": "Server=localhost;Database=IdentityHub;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "EntraId": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<your-tenant-id>",
    "ClientId": "<your-client-id>",
    "ClientSecret": "",
    "Audience": "api://<your-client-id>",
    "UseManagedIdentity": false,
    "GraphApiScopes": ["https://graph.microsoft.com/.default"]
  },
  "TenantConfiguration": {
    "HeaderName": "X-Tenant-Id",
    "EnableStartupSeeding": true,
    "SeedTenantId": "<your-tenant-id>",
    "AllowedTenantIds": ["<your-tenant-id>"]
  }
}
