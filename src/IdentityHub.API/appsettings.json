    "UseManagedIdentity": false,
    "GraphApiScopes": ["https://graph.microsoft.com/.default"]
  },
  "TenantConfiguration": {
    "HeaderName": "X-Tenant-Id",
    "EnableStartupSeeding": true,
    "SeedTenantIds": ["<your-tenant-id>"],
    "AllowedTenantIds": ["<your-tenant-id>"],
    "SeedGroupRoleMappings": [
      {
        "GroupId": "c4de85d6-0780-4280-aa9a-3a30f0a18878",
        "RoleId": "10ec4c1e-04a7-48e6-b27f-08deB90FF885"
      }
    ],
    "SeedUserTenantMappings": [
      {
        "UserId": "<your-user-id>",
